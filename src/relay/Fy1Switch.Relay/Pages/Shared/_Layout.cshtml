@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - Fy1Switch Relay</title>
    <link rel="icon" type="image/png" href="/app-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="/css/relay.css" />
    <script type="module" src="/js/relay.js"></script>
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/" aria-label="Fy1Switch Relay 首页">
            <img class="brand-logo" src="/app-icon.png" asp-append-version="true" width="34" height="34" alt="" />
            <span>Fy1Switch Relay</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav aria-label="管理导航"><a class="active" href="/#devices">设备管理</a><a href="/#security">账户安全</a></nav>
            <button type="button" id="logout" class="text-button logout">退出登录</button>
        }
    </header>
    @RenderBody()
</body>
</html>
